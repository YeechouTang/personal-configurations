[user]
        name = Tang Yizhou
        email = tangyeechou@gmail.com
        #email = yizhou.tang@shopee.com
[core]
        editor = vim
        symlinks = true
        abbrev = 12
[pretty]
        fixes = Fixes: %h (\"%s\")
[commit]
        template = /home/tangyizhou/.gitmsg
        #template = /root/.gitmsg
        verbose = true
[color]
        ui = auto
[init]
        defaultBranch = main
[tag]
        sort = version:refname
[diff]
        algorithm = histogram
        mnemonicPrefix = true
        renames = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        all = true
[rerere]
        enabled = true
        autoupdate = true
[help]
        autocorrect = prompt
[credential]
        helper = store
[http]
        sslVerify = false
        postBuffer = 524288000

[sendemail]
        from = Tang Yizhou  # tangyeechou@gmail.com
        smtpserver = smtp.gmail.com
        smtpuser = tangyeechou@gmail.com
        smtpencryption = tls
        smtppass =   # generated by https://myaccount.google.com/security
        chainreplyto = false
        smtpserverport = 587
        # smtpdomain = ***.com

# in shopee
[sendemail]
        from = Tang Yizhou  # yizhou.tang@shopee.com
        smtpserver = smtp.gmail.com
        smtpuser = yizhou.tang@shopee.com
        smtpencryption = tls
        smtppass =   # generated by https://myaccount.google.com/security
        chainreplyto = false
        smtpserverport = 587
